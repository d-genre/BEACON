# Beacon Backend Environment Variables Example

# 1. Google AI Studio API Key for Gemini 2.5 Flash
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# 2. Supabase JWT Secret Key for token validation
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# 3. PostgreSQL Database Connection URL (Supabase or Local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beacon_db

# 4. SMTP Email Dispatch Credentials (for Password Reset OTP Verification emails)
# For Gmail: Use 'smtp.gmail.com', port 587, your email, and a 16-character App Password generated in Google Account settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@saranathan.ac.in
SMTP_FROM_NAME=FreshersHub Campus Portal
